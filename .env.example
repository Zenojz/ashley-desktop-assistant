OPENAI_API_KEY=
JARVIS_VOICE_PROVIDER=openai
# Optional comma-separated custom word-level wake models. Put each ONNX file
# in assets/wake-word/models/. The bundled hey_jarvis model always remains on.
# JARVIS_EXTRA_WAKE_MODELS=ashley:ashley.onnx,jarvis:jarvis.onnx
# Keep provider selection fail-closed by default. Set to 1 only when an explicit
# OpenAI fallback is desired after Doubao credentials are unavailable.
JARVIS_ALLOW_VOICE_FALLBACK=0
DOUBAO_APP_ID=
DOUBAO_API_KEY=
# Volcengine authorises per resource, and the resource must be named. Copy the
# value shown next to the enabled service in the Doubao speech console; without
# it the server picks a default that the account has probably not been granted.
DOUBAO_RESOURCE_ID=
# Set to 1 only if the handshake still fails — some products bind the grant to
# an app rather than the account.
DOUBAO_SEND_APP_KEY=

# Weather credentials.
# Without these, get_weather reports that the service is not configured.
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# Where "今天天气怎么样" refers to when no city is named.
JARVIS_DEFAULT_CITY=
