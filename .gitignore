node_modules/
dist/
.pnpm-store/
.DS_Store
.env

# electron-builder output. Regenerated by `pnpm package`; ~500MB.
release/

# Source and intermediate helmet models stay local. Only the optimized default
# model is tracked.
assets/helmet/*.glb
!assets/helmet/model.glb

# Never commit personal wake-word training artifacts or recordings.
personal-wake-model.json
recordings/
voice-training/
*.recording.wav
*.recording.webm

# Personal wake-word models are trained on the maintainer's own voice
# and must never be published.
assets/wake-word/models/ashley.onnx
assets/wake-word/models/jarvis.onnx

# Generated corpora, feature arrays, environments, and Python caches.
scripts/wake-word-training/.work/
scripts/wake-word-training/__pycache__/
scripts/wake-word-training/*.pyc
